{
  "name": "df3dmaptool",
  "version": "0.1.0",
  "private": true,
  "description": "面向《三角洲行动》玩家的开源 3D 战术地图查看器",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
